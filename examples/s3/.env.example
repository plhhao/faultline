# Copy to .env and fill the AWS test bucket credentials. .env is Git-ignored.
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL=

# Exact hostname generated by the SDK, or S3_ENDPOINT to derive virtual-hosted style.
S3_TEST_HOST=
# Use a dedicated prefix. Tests create unique keys below it.
S3_TEST_PREFIX=faultline-tests/
# Real AWS requests require an explicit opt-in.
FAULTLINE_S3_TEST=0
