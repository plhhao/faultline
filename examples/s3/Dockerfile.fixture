FROM golang:1.26.4-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY examples/s3/fixture/ ./examples/s3/fixture/
RUN CGO_ENABLED=0 go build -trimpath -o /out/s3-fixture ./examples/s3/fixture

FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/s3-fixture /s3-fixture
USER 65532:65532
ENTRYPOINT ["/s3-fixture"]
